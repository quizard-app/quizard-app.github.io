# Local development environment — copy to `.env` and fill in what you need.
# Everything here stays on your machine (.env is gitignored). Relay secrets
# are uploaded to Cloudflare with `npm run relay:deploy` — never committed.

# ── AI relay (quiz AI, explanations) ──
# One or more Gemini keys, comma-separated. The relay rotates across them
# when one hits its rate limit. https://aistudio.google.com/apikey
GEMINI_KEYS=

# ── Wizard voice (reviewer read-aloud, Fish Audio) ──
# Run `FISH_API_KEY=xxxx node scripts/gen-wizard-voice.mjs` once — it designs
# the "wise old wizard" voice and writes the voice id here automatically.
# Without these the reviewer falls back to the on-device deep synthesis voice.
FISH_API_KEY=
FISH_VOICE_ID=

# ── Relay URL (set by `npm run relay:deploy`; used by `npm run build:pages`) ──
# VITE_API_BASE=https://quizard-relay.<your-subdomain>.workers.dev
VITE_API_BASE=
