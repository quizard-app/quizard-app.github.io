# Local development environment (copy to `.env` if needed). The static app
# has no required backend — AI calls go directly to Google with the user's
# own Gemini key (entered in the app's Settings). Nothing to configure here
# for normal development.

# ── Optional: Fish Audio "wizard voice" relay for reviewer read-aloud ──
# Only used if you host your own TTS relay and build with VITE_API_BASE set.
# Run `FISH_API_KEY=xxxx node scripts/gen-wizard-voice.mjs` once — it designs
# the voice and writes these two values to .env automatically.
# Without them the reviewer falls back to the on-device deep synthesis voice.
FISH_API_KEY=
FISH_VOICE_ID=
